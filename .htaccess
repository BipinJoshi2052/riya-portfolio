# Defense in depth: if this project's root ever ends up as the web root
# instead of the public/ subfolder, block direct access to everything
# except the public/ directory itself.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>

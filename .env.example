# Copy this file to .env and fill in real values. Never commit .env itself.

APP_ENV=production
APP_URL=https://example.com
APP_TIMEZONE=Asia/Kolkata

# MySQL (cPanel: create the DB + user in "MySQL Databases", then fill these in)
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=cpaneluser_portfolio
DB_USERNAME=cpaneluser_dbuser
DB_PASSWORD=change_me

# Gmail SMTP (use a 16-character Google "App Password", not your normal Gmail password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USERNAME=your.address@gmail.com
SMTP_PASSWORD=your_app_password
MAIL_FROM_ADDRESS=your.address@gmail.com
MAIL_FROM_NAME="Riya Portfolio"

# Where contact-form notifications should be delivered.
# Separate multiple addresses with a comma, e.g. you@example.com,partner@example.com
SEND_MAIL_TO=you@example.com

# How many minutes must pass before the same IP counts as a new page view
PAGE_VIEW_COOLDOWN_MINUTES=10

# Default site accent color (hex). This is only the fallback used until an
# admin picks a color on the /admin/theme page — once set there, the
# database value (settings table) takes over.
THEME_PRIMARY_COLOR=#ccff00
